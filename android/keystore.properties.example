# Copy to android/keystore.properties after generating the release keystore.
# Or run: bash scripts/generate-release-keystore.sh
#
# Never commit keystore.properties, KEYSTORE_BACKUP.local.txt,
# or android/app/securepass-upload.keystore

STORE_FILE=securepass-upload.keystore
STORE_PASSWORD=your-store-password
KEY_ALIAS=securepass
KEY_PASSWORD=your-key-password
